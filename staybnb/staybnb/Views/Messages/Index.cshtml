@model List<staybnb.ViewModels.ConversationSummary>
@{
    ViewData["Title"] = "Messages";
}

<h2 class="mb-3">Messages</h2>

@if (!Model.Any())
{
    <p class="text-muted">No conversations yet. Open a property and choose <strong>Message host</strong> to start one.</p>
}

<div class="list-group">
    @foreach (var c in Model)
    {
        <a asp-action="Conversation" asp-route-id="@c.Other.Id"
           class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
            <div>
                <div class="@(c.UnreadCount > 0 ? "fw-bold" : "")">@c.Other.FirstName @c.Other.LastName</div>
                <div class="text-muted small text-truncate" style="max-width:520px">@c.Last.Content</div>
            </div>
            <div class="text-end">
                <small class="text-muted">@c.Last.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")</small>
                @if (c.UnreadCount > 0)
                {
                    <div><span class="badge bg-danger rounded-pill">@c.UnreadCount</span></div>
                }
            </div>
        </a>
    }
</div>
