@model staybnb.ViewModels.HostApplicationViewModel
@{
    ViewData["Title"] = "Become a Host";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="mb-4">Become a Host</h2>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PropertyType" class="form-label"></label>
                    <select asp-for="PropertyType" asp-items="Html.GetEnumSelectList<PropertyType>()" class="form-select"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PricePerNight" class="form-label"></label>
                    <input asp-for="PricePerNight" class="form-control" />
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CleaningFee" class="form-label"></label>
                    <input asp-for="CleaningFee" class="form-control" />
                    <span asp-validation-for="CleaningFee" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="MaxGuests" class="form-label"></label>
                    <input asp-for="MaxGuests" class="form-control" />
                    <span asp-validation-for="MaxGuests" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Bedrooms" class="form-label"></label>
                    <input asp-for="Bedrooms" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Bathrooms" class="form-label"></label>
                    <input asp-for="Bathrooms" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Amenities</label>
                <div class="row">
                    @foreach (var amenity in Model.AvailableAmenities)
                    {
                        <div class="col-6 col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedAmenityIds"
                                       value="@amenity.Id" id="am-@amenity.Id"
                                       checked="@Model.SelectedAmenityIds.Contains(amenity.Id)" />
                                <label class="form-check-label" for="am-@amenity.Id">@amenity.Name</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Property images (at least one)</label>
                <input type="file" name="Images" multiple accept="image/*" class="form-control" />
                <span asp-validation-for="Images" class="text-danger"></span>
            </div>

            <button class="btn btn-danger">Submit application</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}