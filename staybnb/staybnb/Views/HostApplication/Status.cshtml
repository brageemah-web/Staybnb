@model List<staybnb.Models.HostApplication>
@{
    ViewData["Title"] = "Application status";
}

<h2 class="mb-3">Your host applications</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <p>You haven't applied yet. <a asp-action="Create">Become a host</a>.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Property</th><th>City</th><th>Applied</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Property.Title</td>
                    <td>@a.Property.City</td>
                    <td>@a.AppliedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(a.Status == ApplicationStatus.Approved ? "bg-success"
                              : a.Status == ApplicationStatus.Rejected ? "bg-danger"
                              : "bg-warning text-dark")">@a.Status</span>
                        @if (!string.IsNullOrEmpty(a.RejectionReason))
                        {
                            <div class="small text-muted">@a.RejectionReason</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}