@model List<staybnb.Models.HostProperty>
@{
    ViewData["Title"] = "My Properties";
}

<h2 class="mb-3">My Properties</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">You have no properties yet.</p>
}

@foreach (var p in Model)
{
    var image = p.Images.FirstOrDefault()?.ImageUrl;
    <div class="card mb-3">
        <div class="row g-0">
            <div class="col-md-3">
                @if (image != null)
                {
                    <img src="@image" class="img-fluid rounded-start h-100" style="object-fit:cover;max-height:180px;width:100%" alt="@p.Title" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center h-100 text-muted" style="min-height:140px">No image</div>
                }
            </div>
            <div class="col-md-9">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">@p.Title</h5>
                        <div class="text-muted small">@p.City &middot; @p.PropertyType &middot; @p.MaxGuests guests</div>
                        <div class="small mt-2">@p.Bookings.Count booking(s)</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold">R @p.PricePerNight.ToString("N0") <small class="text-muted">/ night</small></div>
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span>
                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="mt-2">
                            <button class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-success")">
                                @(p.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                        <a asp-action="CheckInSetup" asp-route-propertyId="@p.Id" class="btn btn-sm btn-outline-secondary mt-2">Check-in setup</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}