@model List<staybnb.Models.Booking>
@{
    ViewData["Title"] = "Booking Requests";
}

<h2 class="mb-3">Booking Requests</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@{
    var pending = Model.Where(b => b.Status == BookingStatus.Pending).ToList();
    var others = Model.Where(b => b.Status != BookingStatus.Pending).ToList();
}

<h5>Pending (@pending.Count)</h5>
@if (!pending.Any())
{
    <p class="text-muted">No pending requests.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in pending)
            {
                <tr>
                    <td>@b.Guest.FirstName @b.Guest.LastName<br /><small class="text-muted">@b.Guest.Email</small></td>
                    <td>@b.Property.Title</td>
                    <td>@b.CheckInDate.ToString("dd MMM yyyy") &ndash; @b.CheckOutDate.ToString("dd MMM yyyy")<br /><small class="text-muted">@b.Nights night(s)</small></td>
                    <td>@b.NumberOfGuests</td>
                    <td>R @b.TotalPrice.ToString("N2")</td>
                    <td class="d-flex gap-2">
                        <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post">
                            <button class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post"
                              onsubmit="return confirm('Reject this booking?');">
                            <button class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h5 class="mt-5">History</h5>
@if (!others.Any())
{
    <p class="text-muted">Nothing here yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Total</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var b in others)
            {
                <tr>
                    <td>@b.Guest.FirstName @b.Guest.LastName</td>
                    <td>@b.Property.Title</td>
                    <td>@b.CheckInDate.ToString("dd MMM") &ndash; @b.CheckOutDate.ToString("dd MMM yyyy")</td>
                    <td>R @b.TotalPrice.ToString("N2")</td>
                    <td>
                        <span class="badge @(b.Status == BookingStatus.Approved ? "bg-success"
                                            : b.Status == BookingStatus.CheckedIn ? "bg-primary"
                                            : "bg-danger")">@b.Status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}