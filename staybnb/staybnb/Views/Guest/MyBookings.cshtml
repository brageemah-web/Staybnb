@model List<staybnb.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<h2 class="mb-3">My Bookings</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No bookings yet. <a asp-controller="Properties" asp-action="Index">Find a stay</a>.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Property.Title<br /><small class="text-muted">@b.Property.City</small></td>
                    <td>@b.CheckInDate.ToString("dd MMM yyyy") &ndash; @b.CheckOutDate.ToString("dd MMM yyyy")<br /><small class="text-muted">@b.Nights night(s)</small></td>
                    <td>@b.NumberOfGuests</td>
                    <td>R @b.TotalPrice.ToString("N2")</td>
                    <td>
                        <span class="badge @(b.Status == BookingStatus.Approved ? "bg-success"
                                            : b.Status == BookingStatus.CheckedIn ? "bg-primary"
                                            : b.Status == BookingStatus.Pending ? "bg-warning text-dark"
                                            : "bg-danger")">@b.Status</span>
                    </td>
                    <td>
                        @if (b.Status == BookingStatus.Approved || b.Status == BookingStatus.CheckedIn)
                        {
                            <a asp-action="CheckIn" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">
                                @(b.Status == BookingStatus.CheckedIn ? "View check-in" : "Check in")
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}